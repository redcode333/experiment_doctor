# Base URL of your Flagsmith instance, for example http://localhost:8000
FLAGSMITH_URL=
# Flagsmith admin (master) API key. Sent as "Authorization: Api-Key <value>". Never commit it.
FLAGSMITH_TOKEN=
# Environment server-side key. Used by the checkout app's Flagsmith SDK.
FLAGSMITH_ENV_KEY=
# Numeric ID of the Flagsmith project that holds the flag and the experiment.
FLAGSMITH_PROJECT_ID=
# Numeric ID of the environment to read experiments from and pause the flag in.
FLAGSMITH_ENVIRONMENT_ID=
# Name of the flag to gate and pause. No default: this must be set.
FLAGSMITH_FLAG=
# Name of the control variant (the flag value shown when no treatment applies). Empty means "control".
FLAGSMITH_CONTROL_VARIANT=
# GitHub token that can read and write issue comments and read collaborator permissions on GITHUB_REPO.
GITHUB_TOKEN=
# Repository that holds the verdict issue, in owner/repo form.
GITHUB_REPO=
# Issue number where verdict cards are posted and approvals are read.
GITHUB_ISSUE_NUMBER=
# OpenRouter API key used for the explanation step.
OPENROUTER_API_KEY=
# Primary free OpenRouter model. The name must end in :free.
OPENROUTER_MODEL=
# Backup free OpenRouter model. The name must end in :free and must differ from OPENROUTER_MODEL.
OPENROUTER_BACKUP_MODEL=
# Seconds between agent polls of the issue. Empty means 60.
AGENT_POLL_SECONDS=
